[Unit]
Description=Gateway worker (colas interactive, notifications y default)
After=network-online.target postgresql-17.service
Wants=network-online.target

[Service]
User=gateway
Group=gateway
WorkingDirectory=/var/www/gateway
ExecStart=/usr/bin/php artisan queue:work database --queue=interactive,notifications,default --sleep=3 --max-time=3600
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
